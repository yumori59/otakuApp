# fastlane Fastfile
# 参戦名義帳 iOS アプリの TestFlight 自動デプロイ

default_platform(:ios)

platform :ios do
  desc "TestFlight へビルドをアップロード"
  lane :beta do
    # App Store Connect API Key の設定（GitHub Secrets から環境変数経由）
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # XcodeGen でプロジェクトを生成
    sh("cd .. && xcodegen generate")

    # ビルド番号を自動インクリメント（TestFlight の最新ビルド番号 + 1）
    increment_build_number(
      build_number: latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "jp.meigicho.app"
      ) + 1,
      xcodeproj: "meigicho/Meigicho.xcodeproj"
    )

    # コード署名の設定（match または manual）
    # match を使う場合（推奨）:
    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        git_url: ENV["MATCH_GIT_URL"],
        readonly: true,
        api_key: api_key
      )
    else
      # Manual 署名（証明書とプロビジョニングプロファイルを GitHub Secrets から復元）
      import_certificate(
        certificate_path: "certificate.p12",
        certificate_password: ENV["CERT_PASSWORD"],
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
      
      install_provisioning_profile(
        path: "profile.mobileprovision"
      )
    end

    # ビルド
    build_app(
      workspace: "meigicho/Meigicho.xcodeproj/project.xcworkspace",
      scheme: "Meigicho",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "jp.meigicho.app" => ENV["PROVISIONING_PROFILE_SPECIFIER"] || "match AppStore jp.meigicho.app"
        }
      }
    )

    # TestFlight へアップロード（App Store レビューには送らない）
    upload_to_testflight(
      api_key: api_key,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end

  desc "ビルド番号を取得"
  lane :get_build_number do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "jp.meigicho.app"
    )

    puts "最新の TestFlight ビルド番号: #{build_number}"
  end
end
