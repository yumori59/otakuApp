# Local development (copy to .env)
DATABASE_URL="postgres://meigicho:meigicho@localhost:5432/meigicho"
PORT=8080
NODE_ENV=development
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT (access token 発行/検証) ---
# JWT_ACCESS_SECRET は上に定義済み
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=30

# --- Sign in with Apple ---
APPLE_CLIENT_ID=com.example.meigicho
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# --- 共有リンク ---
SHARE_BASE_URL=http://localhost:3000

# メール送信（パスワードリセット）。ローカルはダミー値で未設定扱いにしてログへフォールバックする
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
