generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @db.Uuid
  appleSub           String?   @unique @map("apple_sub")
  googleSub          String?   @unique @map("google_sub")
  email              String?
  passwordHash       String?   @map("password_hash")
  emailNormalized    String?   @unique @map("email_normalized")
  passwordUpdatedAt  DateTime? @map("password_updated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile            Profile?
  entitlement        Entitlement?
  identities         Identity[]
  tours              Tour[]
  events             Event[]
  applications       Application[]
  shareLinks         ShareLink[]
  deviceTokens       DeviceToken[]
  memberships        Membership[]
  refreshTokens      RefreshToken[]
  passwordResetCodes PasswordResetCode[]

  @@map("users")
}

// refresh_tokens と同じ形（生コードは DB に入れない）。パスワードリセットの 8 桁コード。
model PasswordResetCode {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @unique @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_codes_user_idx")
  @@map("password_reset_codes")
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@map("refresh_tokens")
}

model Profile {
  id              String    @id @db.Uuid
  displayName     String?   @map("display_name")
  accountId       String?   @unique @map("account_id")
  username        String?
  appDisplayName  String?   @map("app_display_name")
  themeColor      String    @default("#0017C1") @map("theme_color")
  locale          String    @default("ja_JP")
  timezone        String    @default("Asia/Tokyo")
  onboardedAt     DateTime? @map("onboarded_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Entitlement {
  userId              String    @id @map("user_id") @db.Uuid
  plan                String    @default("free")
  productId           String?   @map("product_id")
  store               String?
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  inGracePeriod       Boolean   @default(false) @map("in_grace_period")
  revenuecatCustomerId String?  @map("revenuecat_customer_id")
  bonusIdentitySlots  Int       @default(0) @map("bonus_identity_slots")
  bonusExpiresAt      DateTime? @map("bonus_expires_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

model Identity {
  id              String    @id @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  displayName     String    @map("display_name")
  relation        String    @default("other")
  color           String    @default("#0017C1")
  joinedOn        DateTime? @map("joined_on") @db.Date
  note            String?
  historyVisible  Boolean   @default(false) @map("history_visible")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  applications Application[] @relation("RepIdentity")
  companions   ApplicationCompanion[]

  @@index([ownerId], map: "identities_owner_idx")
  @@map("identities")
}

model Membership {
  id              String    @id @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  identityId      String    @map("identity_id") @db.Uuid
  fanClubNameRaw  String    @map("fan_club_name_raw")
  memberNoLast4   String?   @map("member_no_last4")
  rank            String?
  renewalOn       DateTime? @map("renewal_on") @db.Date
  feeYen          Int?      @map("fee_yen")
  autoRenew       Boolean   @default(false) @map("auto_renew")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  identity     Identity      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([identityId], map: "memberships_identity_idx")
  @@map("memberships")
}

model Tour {
  id            String    @id @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  artistNameRaw String?   @map("artist_name_raw")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([ownerId, name], map: "tours_owner_name_uniq")
  @@map("tours")
}

model Event {
  id            String    @id @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  tourId        String    @map("tour_id") @db.Uuid
  name          String
  venueNameRaw  String?   @map("venue_name_raw")
  eventDate     DateTime? @map("event_date") @db.Date
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tour         Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([tourId], map: "events_tour_idx")
  @@map("events")
}

model Application {
  id              String    @id @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  repIdentityId   String    @map("rep_identity_id") @db.Uuid
  repMembershipId String?   @map("rep_membership_id") @db.Uuid
  roundName       String?   @map("round_name")
  appliedOn       DateTime? @map("applied_on") @db.Date
  resultOn        DateTime? @map("result_on") @db.Date
  status          String    @default("applied")
  seatRaw         String?   @map("seat_raw")
  ticketCount     Int       @default(1) @map("ticket_count")
  priceYen        Int?      @map("price_yen")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner         User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  repIdentity   Identity               @relation("RepIdentity", fields: [repIdentityId], references: [id], onDelete: Restrict)
  repMembership Membership?            @relation(fields: [repMembershipId], references: [id], onDelete: SetNull)
  companions    ApplicationCompanion[]

  @@index([ownerId], map: "applications_owner_idx")
  @@index([eventId], map: "applications_event_idx")
  @@map("applications")
}

model ApplicationCompanion {
  id            String    @id @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  identityId    String?   @map("identity_id") @db.Uuid
  displayName   String    @map("display_name")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  identity    Identity?   @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([applicationId], map: "app_companions_app_idx")
  @@map("application_companions")
}

model ShareLink {
  id                   String    @id @db.Uuid
  ownerId              String    @map("owner_id") @db.Uuid
  scopeType            String    @map("scope_type")
  scopeId              String?   @map("scope_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  permission           String    @default("read")
  maskMemberNo         Boolean   @default(true) @map("mask_member_no")
  sharedWithAccountIds String[]  @default([]) @map("shared_with_account_ids")
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  viewCount            Int       @default(0) @map("view_count")
  lastViewedAt         DateTime? @map("last_viewed_at") @db.Timestamptz(6)
  editCount            Int       @default(0) @map("edit_count")
  lastEditedAt         DateTime? @map("last_edited_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model DeviceToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @default("ios")
  locale    String?
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}
